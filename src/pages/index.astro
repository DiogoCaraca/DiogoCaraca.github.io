---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import GitHubFeed from '../components/GitHubFeed.astro';
import Experience from '../components/Experience.astro';
import BeyondTeaser from '../components/BeyondTeaser.astro';
import { useTranslations } from '../i18n';
import { getFeedRepos } from '../lib/github';

const t = useTranslations(Astro.currentLocale);
const repos = await getFeedRepos();
---

<Base title={t.meta.title} description={t.meta.description}>
  <Hero />
  <About />
  <Projects />
  <GitHubFeed repos={repos} />
  <Experience />
  <BeyondTeaser />
</Base>
