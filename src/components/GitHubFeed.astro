---
import { useTranslations, formatMonth } from '../i18n';
import { getFeedRepos, GITHUB_USER } from '../lib/github';

interface Props {
  repos: Awaited<ReturnType<typeof getFeedRepos>>;
}

const { repos } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? 'en';

// GitHub linguist colors for the languages Diogo uses.
const languageColors: Record<string, string> = {
  PHP: '#4F5D95',
  JavaScript: '#f1e05a',
  TypeScript: '#3178c6',
  Vue: '#41b883',
  Python: '#3572A5',
  Java: '#b07219',
  Astro: '#ff5a03',
  HTML: '#e34c26',
  CSS: '#663399',
};
---

{
  repos.length > 0 && (
    <section class="section" id="github" aria-labelledby="github-heading">
      <div class="container">
        <div class="section-heading">
          <span class="index" aria-hidden="true">// 05</span>
          <h2 id="github-heading">{t.github.heading}</h2>
        </div>
        <ul class="repos">
          {repos.map((repo) => (
            <li>
              <a class="repo bevel" href={repo.html_url}>
                <span class="name">
                  {repo.name}
                  {repo.stargazers_count > 0 && <span class="stars">★ {repo.stargazers_count}</span>}
                </span>
                {repo.description && <span class="desc">{repo.description}</span>}
                <span class="meta index">
                  {repo.language && (
                    <>
                      <span class="dot" style={`--dot: ${languageColors[repo.language] ?? '#858ca1'}`} aria-hidden="true" />
                      {repo.language} ·{' '}
                    </>
                  )}
                  {t.github.updated} <time datetime={repo.pushed_at}>{formatMonth(repo.pushed_at.slice(0, 7), locale)}</time>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="all">
          <a href={`https://github.com/${GITHUB_USER}?tab=repositories`}>
            {t.github.all} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
    </section>
  )
}

<style>
  .repos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: var(--space-4);
    list-style: none;
  }

  .repo {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-height: 112px;
    height: 100%;
    padding: var(--space-4);
    border: 1px solid var(--border);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 180ms ease-out,
      background-color 180ms ease-out,
      transform 180ms ease-out;
  }

  @media (hover: hover) {
    .repo:hover {
      border-color: var(--cyan-soft);
      background: var(--surface);
      transform: translateY(-2px);
    }
  }

  .name {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    overflow-wrap: anywhere;
  }

  .stars {
    color: var(--text-subtle);
    font-size: var(--fs-xs);
  }

  .desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--dot);
    box-shadow: 0 0 0 1px #ffffff33;
  }

  .all {
    margin-top: var(--space-5);
  }
</style>
